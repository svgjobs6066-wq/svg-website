# Copy to .env.local. Never commit actual credentials.
# Leave Supabase values empty to preview the ten blueprint roles without a backend.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: Supabase project service_role key. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Exact website origin, without a trailing slash. Change for production.
APP_URL=http://localhost:3000
# Generate a random 32-byte secret (e.g. openssl rand -hex 32).
RATE_LIMIT_SECRET=


# Optional: put your PNG at public/brand/logo.png and set /brand/logo.png below.
NEXT_PUBLIC_LOGO_PATH=
# Optional dark logo, used by <Wordmark dark />. Falls back to the default logo.
NEXT_PUBLIC_DARK_LOGO_PATH=

# Set ONLY after approving the maximum resume retention (blueprint suggests 90).
# Empty keeps optional resume uploads disabled. Applications still work without resumes.
RESUME_MAX_RETENTION_DAYS=

# Set this separately in Supabas Edge Function secrets and Vault for the purge schedule.
# Not used by the Next.js frontend.
PURGE_SECRET=
